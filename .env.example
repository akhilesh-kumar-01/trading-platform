# Backend Environment Variables
SERVER_PORT=5454

# Database Configuration (H2 used by default)
SPRING_DATASOURCE_URL=jdbc:h2:mem:treading;DB_CLOSE_DELAY=-1;NON_KEYWORDS=USER
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# Email Service (SMTP)
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_password

# Payment Gateways
STRIPE_API_KEY=sk_test_...
RAZORPAY_API_KEY=rzp_test_...
RAZORPAY_API_SECRET=your_secret_here

# API Keys
COINGECKO_API_KEY=your_coingecko_key
GEMINI_API_KEY=your_gemini_key

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Frontend Environment Variables (React/Vite)
VITE_API_BASE_URL=http://localhost:5454
VITE_GOOGLE_CLIENT_ID=your_google_client_id
